# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# --- A3: Postgres ---
# Running the app on your machine against the container from Stage 0:
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks
# Inside docker compose the host is the service name instead:
# DATABASE_URL=postgres://postgres:dev@db:5432/tasks

# --- A4: Supabase Auth ---
# Dashboard -> Project Settings -> API. Use the anon (public) key.
# NEVER put the service_role key here — it bypasses all security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key
PORT=3000
